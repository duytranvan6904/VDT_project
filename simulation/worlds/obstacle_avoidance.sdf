        <engine>ogre2</engine>
        <scene>scene</scene>
        <ambient_light>0.4 0.4 0.4</ambient_light>
        <background_color>0.7 0.7 0.7</background_color>
        <camera_pose>10 -14 10 0 0.55 0.55</camera_pose>
        <camera_clip><near>0.1</near><far>500</far></camera_clip>
