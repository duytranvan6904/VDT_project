      <pose>4.00 -0.75 1.90 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.40</radius>
              <length>3.80</length>
            </cylinder>
          </geometry>
