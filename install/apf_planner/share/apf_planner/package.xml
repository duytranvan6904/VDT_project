<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>apf_planner</name>
  <version>0.1.0</version>
  <description>APF / Improved APF obstacle-avoidance planner for H-Pad follow and approach.</description>
  <maintainer email="dev@vdt.local">VDT</maintainer>
  <license>Proprietary</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>offboard_manager</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>tf2_ros_py</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>python3-pytest</test_depend>
  <test_depend>launch_pytest</test_depend>
  <test_depend>launch_ros</test_depend>
  <test_depend>ament_index_python</test_depend>
  <test_depend>rosbag2_py</test_depend>
  <test_depend>ros2bag</test_depend>
  <test_depend>rosbag2_storage_default_plugins</test_depend>
  <test_depend>vdt_msgs</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
