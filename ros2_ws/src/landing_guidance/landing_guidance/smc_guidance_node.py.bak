#!/usr/bin/env python3
import time
from typing import Optional

import numpy as np
import rclpy
from diagnostic_msgs.msg import DiagnosticStatus, KeyValue
from geometry_msgs.msg import Twist
from nav_msgs.msg import Odometry
from rclpy.node import Node
from rclpy.qos import HistoryPolicy, QoSProfile, ReliabilityPolicy
from std_msgs.msg import Bool, Float64, String

from landing_guidance.smc_logic import SMCGuidance, SMCParams


class SMCGuidanceNode(Node):
    def __init__(self):
        super().__init__('smc_guidance_node')

        self.declare_parameter('v_max', 1.50)
        self.declare_parameter('v_final_xy_max', 0.35)
        self.declare_parameter('v_descend_fast', 0.35)
        self.declare_parameter('v_descend_touch', 0.15)
        self.declare_parameter('rswitch_default', 0.80)
        self.declare_parameter('final_descent_rxy_m', 1.00)
        self.declare_parameter('final_descent_alt_m', 0.70)
        self.declare_parameter('final_uncertainty_max_2sigma_m', 0.35)
        self.declare_parameter('max_state_age_s', 0.30)
        self.declare_parameter('max_covariance_age_s', 0.30)
        self.declare_parameter('control_rate_hz', 20.0)
        self.declare_parameter('a_max', 1.0)

        def p(name):
            return self.get_parameter(name).value

        params = SMCParams(
            v_max=float(p('v_max')),
            v_final_xy_max=float(p('v_final_xy_max')),
            v_descend_fast=float(p('v_descend_fast')),
            v_descend_touch=float(p('v_descend_touch')),
            rswitch_default=float(p('rswitch_default')),
            final_descent_rxy_m=float(p('final_descent_rxy_m')),
            final_descent_alt_m=float(p('final_descent_alt_m')),
        )
        self.final_unc_max = float(p('final_uncertainty_max_2sigma_m'))
        self.max_state_age = float(p('max_state_age_s'))
        self.max_cov_age = float(p('max_covariance_age_s'))
        self.a_max = float(p('a_max'))
        self.last_cmd = np.zeros(3)
        self.guidance = SMCGuidance(params)

        sensor_qos = QoSProfile(
            reliability=ReliabilityPolicy.BEST_EFFORT,
            history=HistoryPolicy.KEEP_LAST,
            depth=5,
        )

        self.drone_odom: Optional[Odometry] = None
        self.target_odom: Optional[Odometry] = None
        self.phase = 'IDLE'
        self.tracking_mode = 'EXPIRED'
        self.safe = False
        self.unc = float('inf')
        self.rswitch = params.rswitch_default
        self.weight = 1.0
        self.t_odom = 0.0
        self.t_target = 0.0
        self.t_safe = 0.0
        self.t_unc = 0.0
        self.t_step = time.monotonic()
        self.t_log = time.monotonic()

        self.create_subscription(Odometry, '/odom', self._odom_cb, sensor_qos)
        self.create_subscription(Odometry, '/hpad/state_filtered', self._target_cb, 10)
        self.create_subscription(String, '/mission/phase', self._phase_cb, 10)
        self.create_subscription(String, '/ekf/tracking_mode', self._mode_cb, 10)
        self.create_subscription(Bool, '/landing/safe_to_land', self._safe_cb, 10)
        self.create_subscription(Float64, '/landing/uncertainty_radius', self._unc_cb, 10)
        self.create_subscription(Float64, '/landing/rswitch_adaptive', self._rs_cb, 10)
        self.create_subscription(Float64, '/landing/sliding_weight', self._w_cb, 10)

        self.vel_pub = self.create_publisher(Twist, '/landing/velocity_cmd', 10)
        self.active_pub = self.create_publisher(Bool, '/landing/active', 10)
        self.sub_phase_pub = self.create_publisher(String, '/landing/sub_phase', 10)
        self.diag_pub = self.create_publisher(DiagnosticStatus, '/landing/smc_status', 10)

        rate_hz = float(p('control_rate_hz'))
        self.create_timer(1.0 / max(rate_hz, 1.0), self._loop)

    def _odom_cb(self, msg):
        self.drone_odom = msg
        self.t_odom = time.monotonic()

    def _target_cb(self, msg):
        self.target_odom = msg
        self.t_target = time.monotonic()

    def _phase_cb(self, msg):
        prev = self.phase
        self.phase = msg.data
        if self.phase == 'APPROACH' and prev not in ('APPROACH', 'LAND'):
            self.guidance.initialized = False

    def _mode_cb(self, msg):
        self.tracking_mode = msg.data

    def _safe_cb(self, msg):
        self.safe = msg.data
        self.t_safe = time.monotonic()

    def _unc_cb(self, msg):
        self.unc = float(msg.data)
        self.t_unc = time.monotonic()

    def _rs_cb(self, msg):
        self.rswitch = float(msg.data)

    def _w_cb(self, msg):
        self.weight = float(msg.data)

    def _hold(self, state='HOLD'):
        self.guidance.initialized = False
        self.last_cmd = np.zeros(3)
        self.vel_pub.publish(Twist())
        self.active_pub.publish(Bool(data=False))
        self.sub_phase_pub.publish(String(data=state))

    def _loop(self):
        now = time.monotonic()
        dt = now - self.t_step
        self.t_step = now

        if self.phase not in ('APPROACH', 'LAND'):
            self._hold('INACTIVE')
            return
        if self.drone_odom is None or self.target_odom is None:
            self._hold()
            return

        state_ok = (
            now - self.t_odom <= self.max_state_age
            and now - self.t_target <= self.max_state_age
        )
        cov_ok = (
            self.t_safe > 0.0 and self.t_unc > 0.0
            and now - self.t_safe <= self.max_cov_age
            and now - self.t_unc <= self.max_cov_age
        )
        if (
            not state_ok or not cov_ok
            or self.tracking_mode not in ('TRACKING', 'PREDICTING')
            or not self.safe
        ):
            self._hold()
            return

        dp = self.drone_odom.pose.pose.position
        dv = self.drone_odom.twist.twist.linear
        tp = self.target_odom.pose.pose.position
        tv = self.target_odom.twist.twist.linear

        res = self.guidance.step(
            drone_pos=np.array([dp.x, dp.y, dp.z], dtype=np.float64),
            drone_vel=np.array([dv.x, dv.y, dv.z], dtype=np.float64),
            target_pos=np.array([tp.x, tp.y, tp.z], dtype=np.float64),
            target_vel=np.array([tv.x, tv.y, tv.z], dtype=np.float64),
            dt=dt,
            rswitch_override=self.rswitch,
            sliding_weight=self.weight,
        )

        sub_phase = res.sub_phase
        vz = float(res.velocity_cmd[2])
        if (
            res.sub_phase == 'FINAL_DESCENT'
            and self.unc > self.final_unc_max
            and res.r_z > 0.40
        ):
            vz = 0.0
            sub_phase = 'FINAL_GATE_WAIT'

        twist = Twist()
        twist.linear.x = float(res.velocity_cmd[0])
        twist.linear.y = float(res.velocity_cmd[1])
        twist.linear.z = vz
        cmd = np.array([twist.linear.x, twist.linear.y, twist.linear.z])
        step = cmd - self.last_cmd
        n = float(np.linalg.norm(step))
        lim = self.a_max * min(dt, 0.1)
        if n > lim > 0.0:
            cmd = self.last_cmd + step * (lim / n)
        self.last_cmd = cmd
        twist.linear.x, twist.linear.y, twist.linear.z = (float(c) for c in cmd)
        self.vel_pub.publish(twist)
        self.active_pub.publish(Bool(data=bool(res.r_xy <= max(self.rswitch, 0.0))))
        self.sub_phase_pub.publish(String(data=sub_phase))

        diag = DiagnosticStatus()
        diag.level = DiagnosticStatus.OK
        diag.name = 'PrecisionLanding:SMCGuidance'
        diag.message = f'Phase: {sub_phase}'
        diag.hardware_id = 'SLIDING_MODE_GUIDANCE'
        diag.values = [
            KeyValue(key='vx_cmd_mps', value=f'{twist.linear.x:.3f}'),
            KeyValue(key='vy_cmd_mps', value=f'{twist.linear.y:.3f}'),
            KeyValue(key='vz_cmd_mps', value=f'{vz:.3f}'),
            KeyValue(key='r_xy_m', value=f'{res.r_xy:.3f}'),
            KeyValue(key='r_z_m', value=f'{res.r_z:.3f}'),
            KeyValue(key='rswitch_m', value=f'{self.rswitch:.3f}'),
        ]
        self.diag_pub.publish(diag)

        if now - self.t_log > 2.0:
            self.get_logger().info(
                f'[{sub_phase}] Rxy={res.r_xy:.2f} Rz={res.r_z:.2f} '
                f'cmd=({twist.linear.x:.2f},{twist.linear.y:.2f},{vz:.2f})'
            )
            self.t_log = now


def main():
    rclpy.init()
    node = SMCGuidanceNode()
    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass
    finally:
        node.destroy_node()
        rclpy.shutdown()


if __name__ == '__main__':
    main()